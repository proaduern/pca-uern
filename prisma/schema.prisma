generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Acesso
// ---------------------------------------------------------------------------

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unidade {
  id                String   @id @default(cuid())
  nome              String
  email             String   @unique
  senhaHash         String
  senhaTemporaria   Boolean  @default(true)
  elegivelCotaOP    Boolean  @default(false)
  cotaOP            Decimal  @default(0) @db.Decimal(14, 2)
  cotaGeral         Decimal  @default(0) @db.Decimal(14, 2)
  cotaTipo          CotaTipo @default(FECHADA)
  verCotaGeralPCA   Boolean  @default(false)
  ativa             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dfds Dfd[]
}

enum CotaTipo {
  FECHADA
  ABERTA
}

model SetorTecnico {
  id              String   @id @default(cuid())
  nome            String
  email           String   @unique
  senhaHash       String
  senhaTemporaria Boolean  @default(true)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categorias    Categoria[]
  consolidacoes ItemConsolidado[]
}

// ---------------------------------------------------------------------------
// PCA (Plano de Contratações Anual)
// ---------------------------------------------------------------------------

model Pca {
  ano               Int      @id
  ativo             Boolean  @default(false)
  cotaGeral         Decimal  @default(0) @db.Decimal(16, 2)
  cotaOP            Decimal  @default(0) @db.Decimal(16, 2)
  dataAbertura      DateTime @db.Date
  dataFechamento    DateTime @db.Date
  aberturaExtraGeral Boolean @default(false)
  concluido         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  excecoes          PcaExcecao[]
  dfds              Dfd[]
  itensConsolidados ItemConsolidado[]
}

model PcaExcecao {
  id        String  @id @default(cuid())
  pcaAno    Int
  pca       Pca     @relation(fields: [pcaAno], references: [ano])
  unidadeId String

  @@unique([pcaAno, unidadeId])
}

// ---------------------------------------------------------------------------
// Parâmetros (tipificação, prioridade, categoria, catálogo)
// ---------------------------------------------------------------------------

model Tipificacao {
  id   String @id @default(cuid())
  nome String @unique
}

enum NivelPrioridade {
  ALTISSIMA
  ALTA
  MEDIA
  BAIXA
}

model Prioridade {
  id     String          @id @default(cuid())
  frase  String          @unique
  nivel  NivelPrioridade

  dfds Dfd[]
}

enum TipoCategoria {
  MATERIAL
  SERVICO
}

enum ModoServico {
  OBJETO
  VALOR
  ITENS
}

model Categoria {
  id                String        @id @default(cuid())
  nome              String        @unique
  tipo              TipoCategoria @default(MATERIAL)
  semItem           Boolean       @default(false)
  modoServico       ModoServico   @default(OBJETO)
  fluxoContinuo     Boolean       @default(false)
  dependeContrato   Boolean       @default(true)
  saldoAnualGlobal  Decimal?      @db.Decimal(16, 2)
  ignoraPCA         Boolean       @default(false)
  ativa             Boolean       @default(true)
  setorTecnicoId    String?
  setorTecnico      SetorTecnico? @relation(fields: [setorTecnicoId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  itensCatalogo    ItemCatalogo[]
  itensDfd         ItemDfd[]
  itensConsolidados ItemConsolidado[]
}

model ItemCatalogo {
  id          String   @id @default(cuid())
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  item        String
  valor       Decimal  @db.Decimal(14, 2)
  tipoBem     TipoBem  @default(PERMANENTE)
  ativo       Boolean  @default(true)

  @@unique([categoriaId, item])
}

enum TipoBem {
  CONSUMO
  PERMANENTE
}

// ---------------------------------------------------------------------------
// DFD (Documento de Formalização de Demanda)
// ---------------------------------------------------------------------------

enum StatusDfd {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADO
  REPROVADO
}

enum TipoDemanda {
  RENOVACAO
  NOVA
  FLUXO_CONTINUO
}

model Dfd {
  id                String      @id @default(cuid())
  unidadeId         String
  unidade           Unidade     @relation(fields: [unidadeId], references: [id])
  ano               Int
  pca               Pca         @relation(fields: [ano], references: [ano])

  descricaoSumaria  String
  tipificacaoId     String?
  prioridadeId      String
  prioridade        Prioridade  @relation(fields: [prioridadeId], references: [id])
  justificativa     String
  tipoDemanda       TipoDemanda
  dataRenovacao     DateTime?   @db.Date
  dataEntrega       DateTime?   @db.Date

  status            StatusDfd   @default(RASCUNHO)
  enviadoParaAprovacaoEm DateTime?
  aprovadoEm        DateTime?
  reprovadoEm       DateTime?
  motivoReprovacao  String?

  criadoPorId       String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  itens ItemDfd[]

  @@index([unidadeId])
  @@index([status])
  @@index([ano])
}

enum TipoItemDfd {
  MATERIAL
  SERVICO
}

enum Enquadramento {
  OP
  GERAL
  CONVENIO
}

model ItemDfd {
  id          String        @id @default(cuid())
  dfdId       String
  dfd         Dfd           @relation(fields: [dfdId], references: [id], onDelete: Cascade)

  tipo        TipoItemDfd
  enquadramento Enquadramento @default(GERAL)

  convenioNumero    String?
  convenioAno       Int?
  emendaParlamentar Boolean  @default(false)
  parlamentarNome   String?

  categoriaId   String
  categoria     Categoria @relation(fields: [categoriaId], references: [id])
  itemCatalogoNome String?   // nome do item de catálogo escolhido (material ou serviço em modo "itens")
  itemNomeLivre    String?   // nome digitado quando a categoria é "valor livre" (sem catálogo) ou serviço modo "objeto"
  tipoBem       TipoBem?

  quantidade    Decimal?  @db.Decimal(12, 2)
  valorUnit     Decimal?  @db.Decimal(14, 2)
  valorTotal    Decimal   @db.Decimal(14, 2)

  correlacao    String

  itemConsolidadoId String?
  itemConsolidado   ItemConsolidado? @relation(fields: [itemConsolidadoId], references: [id])

  createdAt DateTime @default(now())

  @@index([dfdId])
  @@index([itemConsolidadoId])
}

// ---------------------------------------------------------------------------
// Consolidação (Setor Técnico)
// ---------------------------------------------------------------------------

enum StatusConsolidacao {
  RASCUNHO
  APROVADO
}

// Agrupa itens de DFDs aprovados (de várias unidades/enquadramentos) numa
// única linha de compra por categoria+item, para a licitação (Fase 3).
// Os ItemDfd de origem continuam intactos (ver relação abaixo) — a origem
// por unidade/enquadramento nunca desaparece, só passa a apontar pra cá.
model ItemConsolidado {
  id               String             @id @default(cuid())
  pcaAno           Int
  pca              Pca                @relation(fields: [pcaAno], references: [ano])
  categoriaId      String
  categoria        Categoria          @relation(fields: [categoriaId], references: [id])

  // Chave normalizada (categoria+nome) usada para reagrupar sem duplicar;
  // nomeItem é o rótulo exibido, editável pelo Setor Técnico.
  chaveAgrupamento String
  nomeItem         String

  quantidadeTotal  Decimal            @db.Decimal(12, 2)
  valorTotal       Decimal            @db.Decimal(14, 2)

  status           StatusConsolidacao @default(RASCUNHO)
  aprovadoPorId    String?
  aprovadoPor      SetorTecnico?      @relation(fields: [aprovadoPorId], references: [id])
  aprovadoEm       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  origens ItemDfd[]

  @@index([pcaAno, categoriaId, chaveAgrupamento])
}
