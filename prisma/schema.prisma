generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Acesso
// ---------------------------------------------------------------------------

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unidade {
  id              String   @id @default(cuid())
  nome            String
  email           String   @unique
  senhaHash       String
  senhaTemporaria Boolean  @default(true)
  elegivelCotaOP  Boolean  @default(false)
  cotaOP          Decimal  @default(0) @db.Decimal(14, 2)
  cotaGeral       Decimal  @default(0) @db.Decimal(14, 2)
  cotaTipo        CotaTipo @default(FECHADA)
  verCotaGeralPCA Boolean  @default(false)
  ativa           Boolean  @default(true)

  responsavelNome      String?
  responsavelMatricula String?
  responsavelTelefone  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dfds                 Dfd[]
  setoresVinculados    SetorTecnico[]
  licitacoesVinculadas Licitacoes[]
  setoresInternos      SetorInterno[]

  categoriasRestritas    Categoria[]    @relation("CategoriaRestricaoUnidades")
  itensCatalogoRestritos ItemCatalogo[] @relation("ItemCatalogoRestricaoUnidades")

  solicitacoesCatalogo SolicitacaoCatalogo[]

  acessosExecucaoVinculados  AcessoExecucao[]
  acessosEntregaVinculados   AcessoEntrega[]
  acessosGestorAtaVinculados AcessoGestorAta[]
  entregas                   Entrega[]
}

enum CotaTipo {
  FECHADA
  ABERTA
}

// Setor interno de uma Unidade demandante (ex.: um departamento ou curso
// dentro da unidade) — só a própria Unidade (e a PROAD) enxerga e gerencia
// os seus. Tem login e senha próprios (sempre — nunca "vinculado" a outra
// conta, ao contrário de SetorTecnico/Licitacoes/etc.), e uma fatia fixa
// (cotaOP/cotaGeral) da cota da própria Unidade, que funciona como um teto
// adicional: o gasto do setor não pode passar da sua fatia, mesmo que a
// Unidade como um todo ainda tenha saldo (ver lib/actions/dfd.ts).
model SetorInterno {
  id              String   @id @default(cuid())
  unidadeId       String
  unidade         Unidade  @relation(fields: [unidadeId], references: [id])
  nome            String
  email           String   @unique
  senhaHash       String
  senhaTemporaria Boolean  @default(true)
  ativo           Boolean  @default(true)
  cotaOP          Decimal  @default(0) @db.Decimal(14, 2)
  cotaGeral       Decimal  @default(0) @db.Decimal(14, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dfds Dfd[]

  @@index([unidadeId])
}

// Login de setor técnico: OU tem email/senha próprios, OU é "vinculado" ao
// login de uma unidade demandante já existente (mesmo email/senha — quem
// loga escolhe, na hora, se entra como unidade ou como setor técnico).
model SetorTecnico {
  id              String   @id @default(cuid())
  nome            String
  vinculado       Boolean  @default(false)
  unidadeId       String?
  unidade         Unidade? @relation(fields: [unidadeId], references: [id])
  email           String?  @unique
  senhaHash       String?
  senhaTemporaria Boolean  @default(true)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categorias    Categoria[]
  consolidacoes ConsolidacaoTecnica[]
  itensTecnicos ItemTecnico[]
  substituicoes ItemDfd[]             @relation("SubstituicaoPorSetor")
}

// Login da Diretoria de Licitações e Contratos: vê todas as consolidações
// de todos os setores técnicos, independente da categoria. Mesmo esquema de
// vínculo do SetorTecnico.
model Licitacoes {
  id              String   @id @default(cuid())
  nome            String
  vinculado       Boolean  @default(false)
  unidadeId       String?
  unidade         Unidade? @relation(fields: [unidadeId], references: [id])
  email           String?  @unique
  senhaHash       String?
  senhaTemporaria Boolean  @default(true)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  statusLicitacao        StatusLicitacao[]
  consolidacoesRevisadas ConsolidacaoTecnica[]
}

// Login da Unidade de Execução de Compras e Contratações. Mesmo esquema de
// vínculo do SetorTecnico/Licitacoes, mais um subperfil fixo (o roteamento de
// qual categoria cai em qual subperfil é regra de negócio, não campo de acesso).
enum SubperfilExecucao {
  OBRAS
  SERVICOS
  MATERIAIS_PATRIMONIO
}

model AcessoExecucao {
  id              String            @id @default(cuid())
  nome            String
  subperfil       SubperfilExecucao
  vinculado       Boolean           @default(false)
  unidadeId       String?
  unidade         Unidade?          @relation(fields: [unidadeId], references: [id])
  email           String?           @unique
  senhaHash       String?
  senhaTemporaria Boolean           @default(true)
  ativo           Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  processos         ProcessoExecucao[]
  statusRegistrados StatusExecucao[]
}

// Login da Unidade de Entrega de Bens (Patrimônio ou Almoxarifado).
enum SubperfilEntrega {
  PATRIMONIO
  ALMOXARIFADO
}

model AcessoEntrega {
  id              String           @id @default(cuid())
  nome            String
  subperfil       SubperfilEntrega
  vinculado       Boolean          @default(false)
  unidadeId       String?
  unidade         Unidade?         @relation(fields: [unidadeId], references: [id])
  email           String?          @unique
  senhaHash       String?
  senhaTemporaria Boolean          @default(true)
  ativo           Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  statusEntregaRegistrados StatusEntrega[]
  atendimentosPropostos    AtendimentoEstoque[]
  trocasOPAnalisadas       TrocaOP[]
  entregasAtribuidas       Entrega[]
  contestacoesAnalisadas   ConfirmacaoEntrega[]
}

// Login da Unidade Gestora de Ata de Registro de Preços.
model AcessoGestorAta {
  id              String   @id @default(cuid())
  nome            String
  vinculado       Boolean  @default(false)
  unidadeId       String?
  unidade         Unidade? @relation(fields: [unidadeId], references: [id])
  email           String?  @unique
  senhaHash       String?
  senhaTemporaria Boolean  @default(true)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consolidacoesSolicitadas ConsolidacaoTecnica[]
}

// ---------------------------------------------------------------------------
// PCA (Plano de Contratações Anual)
// ---------------------------------------------------------------------------

model Pca {
  ano                Int       @id
  ativo              Boolean   @default(false)
  cotaGeral          Decimal   @default(0) @db.Decimal(16, 2)
  cotaOP             Decimal   @default(0) @db.Decimal(16, 2)
  dataAbertura       DateTime  @db.Date
  dataFechamento     DateTime  @db.Date
  aberturaExtraGeral Boolean   @default(false)
  concluido          Boolean   @default(false)
  concluidoEm        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  excecoes      PcaExcecao[]
  dfds          Dfd[]
  consolidacoes ConsolidacaoTecnica[]
}

model PcaExcecao {
  id        String @id @default(cuid())
  pcaAno    Int
  pca       Pca    @relation(fields: [pcaAno], references: [ano])
  unidadeId String

  @@unique([pcaAno, unidadeId])
}

// ---------------------------------------------------------------------------
// Parâmetros (tipificação, prioridade, categoria, catálogo)
// ---------------------------------------------------------------------------

model Tipificacao {
  id   String @id @default(cuid())
  nome String @unique
}

enum NivelPrioridade {
  ALTISSIMA
  ALTA
  MEDIA
  BAIXA
}

model Prioridade {
  id    String          @id @default(cuid())
  frase String          @unique
  nivel NivelPrioridade

  dfds Dfd[]
}

enum TipoCategoria {
  MATERIAL
  SERVICO
}

enum ModoServico {
  OBJETO
  VALOR
  ITENS
}

// Visibilidade de catálogo/categoria por unidade, extraída do sistema
// original: TODAS (padrão, sem restrição), SOMENTE (visível só para as
// unidades listadas) ou EXCETO (visível para todas, menos as listadas).
enum ModoRestricao {
  TODAS
  SOMENTE
  EXCETO
}

model Categoria {
  id               String        @id @default(cuid())
  nome             String        @unique
  tipo             TipoCategoria @default(MATERIAL)
  semItem          Boolean       @default(false)
  modoServico      ModoServico   @default(OBJETO)
  fluxoContinuo    Boolean       @default(false)
  dependeContrato  Boolean       @default(true)
  saldoAnualGlobal Decimal?      @db.Decimal(16, 2)
  ignoraPCA        Boolean       @default(false)
  ativa            Boolean       @default(true)

  // Classificação orçamentária (ex.: "3.3.9.0.30 Material de Consumo"),
  // só para identificação nos relatórios — não afeta nenhuma regra de negócio.
  classificacaoRubrica String?

  // Só se aplica a categorias de material sem catálogo (semItem=true): como
  // o item não vem de um ItemCatalogo (que já carrega seu próprio tipoBem),
  // a categoria precisa fixar se é bem permanente ou de consumo, para que o
  // roteamento de execução/entrega (Patrimônio x Almoxarifado) saiba prever
  // isso mesmo antes de a demanda ter itens — ver lib/actions/dfd.ts.
  tipoBemPadrao TipoBem?
  setorTecnicoId   String?
  setorTecnico     SetorTecnico? @relation(fields: [setorTecnicoId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Roteamento padrão à Execução é calculado pelo nome/tipo da categoria
  // (replica a lista fixa CATEGORIAS_SERVICO do legado — ver lib/execucao.ts);
  // este campo só existe para excepcionar esse padrão caso a caso.
  subperfilExecucaoOverride SubperfilExecucao?

  restricaoModo     ModoRestricao @default(TODAS)
  unidadesRestritas Unidade[]     @relation("CategoriaRestricaoUnidades")

  itensCatalogo       ItemCatalogo[]
  itensDfd            ItemDfd[]
  itensTecnicos       ItemTecnico[]
  consolidacoes       ConsolidacaoTecnica[]
  entregas            Entrega[]
  trocasOPPretendidas TrocaOP[]

  solicitacoesCatalogo SolicitacaoCatalogo[]
}

model ItemCatalogo {
  id          String    @id @default(cuid())
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  item        String
  valor       Decimal   @db.Decimal(14, 2)
  tipoBem     TipoBem   @default(PERMANENTE)
  ativo       Boolean   @default(true)

  // Item incluído no catálogo a partir de uma SolicitacaoCatalogo aceita
  // pela PROAD (em vez de cadastro manual direto) — só decorativo/informativo.
  origemSolicitacao Boolean @default(false)

  // null = herda a regra de visibilidade da categoria; qualquer outro valor
  // sobrescreve a regra da categoria só para este item.
  restricaoModo     ModoRestricao?
  unidadesRestritas Unidade[]      @relation("ItemCatalogoRestricaoUnidades")

  @@unique([categoriaId, item])
}

// Unidade pede a inclusão de um item novo no catálogo padronizado (ex.: não
// achou o material desejado no wizard de DFD); a PROAD analisa e aceita
// (criando o ItemCatalogo correspondente) ou rejeita.
enum StatusSolicitacao {
  PENDENTE
  ACEITO
  REJEITADO
}

model SolicitacaoCatalogo {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  nomeResumido    String
  descricao       String
  marcaModelo     String?
  link            String?
  aplicacao       String
  valorEstimado   Decimal           @db.Decimal(14, 2)
  tipoBemSugerido TipoBem
  status          StatusSolicitacao @default(PENDENTE)

  // Preenchidos pela PROAD ao aceitar (podem divergir do que a unidade sugeriu).
  categoriaFinalId String?
  categoriaFinal   Categoria? @relation(fields: [categoriaFinalId], references: [id])
  itemFinal        String?
  valorFinal       Decimal?   @db.Decimal(14, 2)
  tipoBemFinal     TipoBem?

  motivoRejeicao String?
  analisadoEm    DateTime?

  createdAt DateTime @default(now())

  @@index([unidadeId])
  @@index([status])
}

enum TipoBem {
  CONSUMO
  PERMANENTE
}

// ---------------------------------------------------------------------------
// DFD (Documento de Formalização de Demanda)
// ---------------------------------------------------------------------------

enum StatusDfd {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADO
  REPROVADO
}

enum TipoDemanda {
  RENOVACAO
  NOVA
  FLUXO_CONTINUO
}

model Dfd {
  id        String  @id @default(cuid())
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])
  ano       Int
  pca       Pca     @relation(fields: [ano], references: [ano])
  // Número sequencial do DFD dentro da própria unidade/ano (ex.: "0007/2027"),
  // atribuído uma única vez na criação — usado no cabeçalho do PDF oficial do
  // DFD (ver lib/pdf/dfd.tsx). Nunca reatribuído, mesmo se um DFD anterior
  // da sequência for excluído.
  numero    Int

  descricaoSumaria String
  tipificacaoId    String?
  prioridadeId     String
  prioridade       Prioridade  @relation(fields: [prioridadeId], references: [id])
  justificativa    String
  tipoDemanda      TipoDemanda
  dataRenovacao    DateTime?   @db.Date
  dataEntrega      DateTime?   @db.Date

  status                 StatusDfd @default(RASCUNHO)
  enviadoParaAprovacaoEm DateTime?
  aprovadoEm             DateTime?
  reprovadoEm            DateTime?
  motivoReprovacao       String?

  // Preenchido quando o DFD foi lançado por um setor interno da unidade (em
  // vez do login da própria unidade) — o DFD continua pertencendo à unidade
  // (unidadeId acima), isto é só uma anotação de origem, visível apenas para
  // a unidade e a PROAD (nunca para Setor Técnico/Licitações/Execução).
  setorInternoId String?
  setorInterno   SetorInterno? @relation(fields: [setorInternoId], references: [id])
  // Setor interno enviou para a unidade revisar (fica parado em RASCUNHO até
  // a unidade liberar para a PROAD com enviarParaAprovacaoAction, ou reabrir
  // para o setor com reabrirParaSetorAction) — null quando não se aplica.
  enviadoParaUnidadeEm DateTime?

  criadoPorId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens ItemDfd[]

  @@unique([unidadeId, ano, numero])
  @@index([unidadeId])
  @@index([status])
  @@index([ano])
  @@index([setorInternoId])
}

enum TipoItemDfd {
  MATERIAL
  SERVICO
}

enum Enquadramento {
  OP
  GERAL
  CONVENIO
  RECURSOS_EXTRA
}

model ItemDfd {
  id    String @id @default(cuid())
  dfdId String
  dfd   Dfd    @relation(fields: [dfdId], references: [id], onDelete: Cascade)

  tipo          TipoItemDfd
  enquadramento Enquadramento @default(GERAL)

  convenioNumero    String?
  convenioAno       Int?
  emendaParlamentar Boolean @default(false)
  parlamentarNome   String?

  // Recursos arrecadados pela própria Unidade (evento/projeto) — assim como
  // Convênio, não se sujeita aos limites do PCA (ver lib/cota.ts).
  recursoExtraAgencia String?
  recursoExtraConta   String?

  categoriaId      String
  categoria        Categoria @relation(fields: [categoriaId], references: [id])
  itemCatalogoNome String? // nome do item de catálogo escolhido (material ou serviço em modo "itens")
  itemNomeLivre    String? // nome digitado quando a categoria é "valor livre" (sem catálogo) ou serviço modo "objeto"
  tipoBem          TipoBem?

  quantidade Decimal? @db.Decimal(12, 2)
  valorUnit  Decimal? @db.Decimal(14, 2)
  valorTotal Decimal  @db.Decimal(14, 2)

  correlacao String

  // Consolidação: o item nunca é somado/substituído por uma linha agregada —
  // só ganha uma referência a qual processo de consolidação o inclui, e
  // continua existindo com sua unidade/enquadramento/quantidade originais.
  consolidacaoTecnicaId String?
  consolidacaoTecnica   ConsolidacaoTecnica? @relation(fields: [consolidacaoTecnicaId], references: [id])

  // Substituição de item pelo setor técnico (troca por outro do catálogo,
  // mantendo a quantidade pedida) — snapshot do item original + motivo.
  itemSubstituidoNome       String?
  itemSubstituidoValorUnit  Decimal?      @db.Decimal(14, 2)
  itemSubstituidoTipoBem    TipoBem?
  substituicaoJustificativa String?
  substituicaoPorId         String?
  substituicaoPor           SetorTecnico? @relation("SubstituicaoPorSetor", fields: [substituicaoPorId], references: [id])
  substituicaoEm            DateTime?

  // Resultado da homologação (Licitação) — preenchido por item/grupo.
  resultadoHomologacao ResultadoHomologacao?
  valorAdjudicado      Decimal?              @db.Decimal(14, 2)

  // Divisão por resultado/recebimento/entrega PARCIAL: a parte separada vira
  // uma nova linha (mesmo dfd, mesma origem); o item de origem permanece com
  // a quantidade remanescente, ainda pendente — nunca se perde nem se funde.
  itemOrigemDivisaoId String?
  itemOrigemDivisao   ItemDfd?  @relation("DivisaoItemDfd", fields: [itemOrigemDivisaoId], references: [id])
  itensDivididos      ItemDfd[] @relation("DivisaoItemDfd")

  processoExecucaoId String?
  processoExecucao   ProcessoExecucao? @relation(fields: [processoExecucaoId], references: [id])

  // Atendimento por Estoque / Troca de Item (OP): o item perde a destinação
  // específica e passa a ser reposição de "estoque geral" (ver
  // AtendimentoEstoque/TrocaOP) — seu ciclo de licitação/execução real
  // continua, agora só para fins de métrica do PCA, não mais para a unidade.
  estoqueGeral      Boolean   @default(false)
  estoqueGeralDesde DateTime?
  viaTrocaOP        Boolean   @default(false)

  atendimentoEstoque AtendimentoEstoque?
  trocaOP            TrocaOP?            @relation("ItemComTrocaOP")
  trocaOPOrigem      TrocaOP?            @relation("ItemGeradoPorTrocaOP")
  entrega            Entrega?

  createdAt DateTime @default(now())

  @@index([dfdId])
  @@index([consolidacaoTecnicaId])
  @@index([processoExecucaoId])
}

// ---------------------------------------------------------------------------
// Consolidação (Setor Técnico)
// ---------------------------------------------------------------------------

// Item incluído pelo próprio setor técnico numa categoria, sem que nenhuma
// unidade tenha lançado DFD para ele (ex.: uma necessidade técnica que só o
// setor identifica, como uma licença de software).
model ItemTecnico {
  id          String    @id @default(cuid())
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  item       String
  valorUnit  Decimal @db.Decimal(14, 2)
  quantidade Decimal @db.Decimal(12, 2)
  valorTotal Decimal @db.Decimal(14, 2)
  tipoBem    TipoBem
  correlacao String // justificativa técnica

  itemSubstituidoNome       String?
  itemSubstituidoValorUnit  Decimal?  @db.Decimal(14, 2)
  itemSubstituidoTipoBem    TipoBem?
  substituicaoJustificativa String?
  substituicaoEm            DateTime?

  // Mesmo mecanismo de ItemDfd — ver comentário lá. ItemTecnico não tem
  // demandante, então não participa de Atendimento por Estoque nem Troca OP.
  resultadoHomologacao ResultadoHomologacao?
  valorAdjudicado      Decimal?              @db.Decimal(14, 2)

  itemOrigemDivisaoId String?
  itemOrigemDivisao   ItemTecnico?  @relation("DivisaoItemTecnico", fields: [itemOrigemDivisaoId], references: [id])
  itensDivididos      ItemTecnico[] @relation("DivisaoItemTecnico")

  processoExecucaoId String?
  processoExecucao   ProcessoExecucao? @relation(fields: [processoExecucaoId], references: [id])

  entrega Entrega?

  criadoPorId String
  criadoPor   SetorTecnico @relation(fields: [criadoPorId], references: [id])
  createdAt   DateTime     @default(now())

  consolidacaoTecnicaId String?
  consolidacaoTecnica   ConsolidacaoTecnica? @relation(fields: [consolidacaoTecnicaId], references: [id])

  @@index([categoriaId])
  @@index([consolidacaoTecnicaId])
  @@index([processoExecucaoId])
}

enum PrioridadeConsolidacao {
  ALTA
  MEDIA
  BAIXA
}

enum TipoContratacao {
  NORMAL // contrato/empenho — segue direto para Execução
  ATA // Ata de Registro de Preços — passa por Gestão de Ata + autorização da PROAD
}

// Um processo de consolidação = um conjunto de itens (de DFDs aprovados e/ou
// incluídos pelo setor técnico) que o setor técnico decidiu levar junto para
// uma mesma licitação, sob um processo SEI/ETP. Não é uma soma automática:
// os itens de origem continuam existindo com sua própria unidade,
// quantidade e enquadramento — só passam a apontar para cá.
model ConsolidacaoTecnica {
  id             String       @id @default(cuid())
  categoriaId    String
  categoria      Categoria    @relation(fields: [categoriaId], references: [id])
  setorTecnicoId String
  setorTecnico   SetorTecnico @relation(fields: [setorTecnicoId], references: [id])
  pcaAno         Int
  pca            Pca          @relation(fields: [pcaAno], references: [ano])

  processoSEI           String
  idDocumentoETP        String
  dataETP               DateTime               @db.Date
  prioridade            PrioridadeConsolidacao
  tipoContratacao       TipoContratacao
  dataEsperadaConclusao DateTime               @db.Date

  // Preenchido pela PROAD depois de cadastrar o PCA no PNCP; obrigatório
  // para todas as consolidações do ano antes de poder concluir o PCA.
  codigoPca String?

  createdAt DateTime @default(now())

  itensDfd      ItemDfd[]
  itensTecnicos ItemTecnico[]

  // Fase 3 (Licitações): status atual = última linha por createdAt.
  statusLicitacao StatusLicitacao[]

  // Revisão de prioridade/prazo pela Licitação — a marcação original do Setor
  // Técnico acima (prioridade/dataEsperadaConclusao) é preservada; isto fica
  // como um registro à parte, com justificativa obrigatória.
  revisaoPrioridade            PrioridadeConsolidacao?
  revisaoDataEsperadaConclusao DateTime?               @db.Date
  revisaoJustificativa         String?
  revisaoEm                    DateTime?
  revisaoPorId                 String?
  revisaoPor                   Licitacoes?             @relation(fields: [revisaoPorId], references: [id])

  // Ata de Registro de Preços (tipoContratacao=ATA): a Unidade Gestora de Ata
  // solicita a execução, a PROAD autoriza — ao autorizar, o processo avança
  // automaticamente para "remetido_execucao" (sem ação manual da Licitação).
  solicitacaoExecucaoAtaEm    DateTime?
  solicitacaoExecucaoAtaPorId String?
  solicitacaoExecucaoAtaPor   AcessoGestorAta? @relation(fields: [solicitacaoExecucaoAtaPorId], references: [id])
  ataAutorizadaEm             DateTime?

  processosExecucao ProcessoExecucao[]

  @@index([pcaAno, categoriaId])
}

// ---------------------------------------------------------------------------
// Licitações (Fase 3)
// ---------------------------------------------------------------------------

enum StatusLicitacaoValor {
  PESQUISA_PRECOS
  TERMO_REFERENCIA
  DILIGENCIA_DEMANDANTE
  MINUTAS
  ANALISE_JURIDICA
  DILIGENCIAS_PGE
  SESSAO_MARCADA
  ANALISE_PROPOSTAS
  RECURSO
  HOMOLOGADO
  ASSINATURA_CONTRATO
  REMETIDO_EXECUCAO
  REMETIDO_GESTOR_ATA
}

// Um registro por avanço de status (nunca editado depois) — status atual é
// sempre o último por createdAt. Os campos abaixo cobrem a união de tudo que
// algum status pode pedir (cada status só usa os seus, o resto fica null).
model StatusLicitacao {
  id             String               @id @default(cuid())
  consolidacaoId String
  consolidacao   ConsolidacaoTecnica  @relation(fields: [consolidacaoId], references: [id], onDelete: Cascade)
  status         StatusLicitacaoValor

  responsavel     String? // pesquisa_precos / termo_referencia / minutas
  dataDiligencia  DateTime? @db.Date // diligencia_demandante
  prazoResposta   DateTime? @db.Date // diligencia_demandante
  dataSessao      DateTime? @db.Date // sessao_marcada
  agenteNome      String? // sessao_marcada
  agenteMatricula String? // sessao_marcada

  // Nulo quando o status foi lançado pela PROAD (ex.: autorização de execução
  // de ata, que encaminha automaticamente para "remetido_execucao") em vez
  // da Unidade de Licitações.
  criadoPorId String?
  criadoPor   Licitacoes? @relation(fields: [criadoPorId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([consolidacaoId])
}

enum ResultadoHomologacao {
  SUCESSO
  FRACASSADO
  DESERTO
}

// ---------------------------------------------------------------------------
// Execução (Fase 4)
// ---------------------------------------------------------------------------

// Um processo de execução = um subconjunto dos itens homologados com êxito de
// uma consolidação, agrupados pela Unidade de Execução sob um novo processo
// SEI próprio (pode haver mais de um processo de execução por consolidação).
model ProcessoExecucao {
  id                  String              @id @default(cuid())
  consolidacaoId      String
  consolidacao        ConsolidacaoTecnica @relation(fields: [consolidacaoId], references: [id])
  subperfil           SubperfilExecucao
  acessoExecucaoId    String
  acessoExecucao      AcessoExecucao      @relation(fields: [acessoExecucaoId], references: [id])
  processoSEIExecucao String

  itensDfd      ItemDfd[]
  itensTecnicos ItemTecnico[]

  statusExecucao StatusExecucao[]
  entregas       Entrega[]

  createdAt DateTime @default(now())

  @@index([consolidacaoId])
}

enum StatusExecucaoValor {
  REMETIDO_FORNECEDOR
  REJEITADA_FORNECEDOR
  RECEBIDA_CONFERENCIA
  RECEBIDA_DEFINITIVO
}

model StatusExecucao {
  id                 String              @id @default(cuid())
  processoExecucaoId String
  processoExecucao   ProcessoExecucao    @relation(fields: [processoExecucaoId], references: [id], onDelete: Cascade)
  status             StatusExecucaoValor

  dataEnvio DateTime? @db.Date // remetido_fornecedor
  prazoDias Int? // remetido_fornecedor — prazo contratual, em dias; "em atraso" é calculado (dataEnvio + prazoDias < hoje)

  criadoPorId String
  criadoPor   AcessoExecucao @relation(fields: [criadoPorId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([processoExecucaoId])
}

// ---------------------------------------------------------------------------
// Entrega de Bens (Fase 4) + casos especiais (Fase 5)
// ---------------------------------------------------------------------------

// Uma entrega é um registro autocontido (categoria/item/valor snapshot no
// momento da autorização) — não é sempre um espelho 1:1 de um ItemDfd/
// ItemTecnico: Atendimento por Estoque gera uma entrega avulsa ("carimbada"),
// sem item de origem, enquanto o item real segue seu próprio ciclo (vira
// "estoque geral"). itemDfdId/itemTecnicoId são só a referência solta usada
// para localizar a quantidade total ao registrar uma entrega parcial.
model Entrega {
  id              String           @id @default(cuid())
  unidadeId       String?
  unidade         Unidade?         @relation(fields: [unidadeId], references: [id])
  categoriaId     String
  categoria       Categoria        @relation(fields: [categoriaId], references: [id])
  itemNome        String
  enquadramento   Enquadramento
  tipoBem         TipoBem?
  subperfilBens   SubperfilEntrega
  valorAdjudicado Decimal          @db.Decimal(14, 2)

  processoExecucaoId String?
  processoExecucao   ProcessoExecucao? @relation(fields: [processoExecucaoId], references: [id])
  acessoEntregaId    String?
  acessoEntrega      AcessoEntrega?    @relation(fields: [acessoEntregaId], references: [id])

  itemDfdId     String?      @unique
  itemDfd       ItemDfd?     @relation(fields: [itemDfdId], references: [id])
  itemTecnicoId String?      @unique
  itemTecnico   ItemTecnico? @relation(fields: [itemTecnicoId], references: [id])

  viaEstoque Boolean @default(false)
  viaTrocaOP Boolean @default(false)

  statusEntrega      StatusEntrega[]
  confirmacoes       ConfirmacaoEntrega[]
  atendimentoEstoque AtendimentoEstoque?

  createdAt DateTime @default(now())

  @@index([unidadeId])
}

enum StatusEntregaValor {
  EM_ESTOQUE
  AUTORIZADO_PROAD
  ENTREGA_ANDAMENTO
  ENTREGUE
}

model StatusEntrega {
  id        String             @id @default(cuid())
  entregaId String
  entrega   Entrega            @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  status    StatusEntregaValor

  // Nulo quando o status foi lançado pela PROAD (ex.: autorização em lote,
  // atendimento por estoque, troca OP) em vez da Unidade de Entrega de Bens.
  criadoPorId String?
  criadoPor   AcessoEntrega? @relation(fields: [criadoPorId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([entregaId])
}

// Aceite tácito em 10 dias / contestação do demandante sobre uma entrega
// marcada como "entregue". Uma entrega pode passar por mais de um ciclo: se
// a Administração ratifica uma contestação, a entrega é reaberta e um novo
// ciclo de confirmação começa quando ela for marcada como entregue de novo —
// o ciclo anterior fica preservado aqui, nunca é apagado.
enum StatusConfirmacaoEntrega {
  PENDENTE
  CONFIRMADO
  CONTESTACAO_PENDENTE_ENTREGA
  CONTESTACAO_PENDENTE_ADMIN
  CONTESTACAO_RATIFICADA
  CONTESTACAO_REJEITADA
}

model ConfirmacaoEntrega {
  id           String                   @id @default(cuid())
  entregaId    String
  entrega      Entrega                  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  status       StatusConfirmacaoEntrega @default(PENDENTE)
  dataLimite   DateTime                 @db.Date
  confirmadoEm DateTime?

  contestacaoMotivo                   String?
  contestacaoSolicitadoEm             DateTime?
  contestacaoAnaliseEntregaOk         Boolean?
  contestacaoAnaliseEntregaComentario String?
  contestacaoAnaliseEntregaPorId      String?
  contestacaoAnaliseEntregaPor        AcessoEntrega? @relation(fields: [contestacaoAnaliseEntregaPorId], references: [id])
  contestacaoAnaliseEntregaEm         DateTime?
  contestacaoAnaliseAdminOk           Boolean?
  contestacaoAnaliseAdminEm           DateTime?

  createdAt DateTime @default(now())

  @@index([entregaId])
}

// ---------------------------------------------------------------------------
// Casos especiais (Fase 5)
// ---------------------------------------------------------------------------

enum StatusAtendimentoEstoque {
  PENDENTE_PROAD
  APROVADO
  REJEITADO
}

// Exceção do Patrimônio para itens OP já consolidados: propõe atender de
// imediato com o que já tem em estoque, sem esperar a licitação terminar. A
// PROAD aprova (gera uma Entrega avulsa "carimbada" — ver Entrega) ou rejeita.
model AtendimentoEstoque {
  id              String                   @id @default(cuid())
  itemDfdId       String                   @unique
  itemDfd         ItemDfd                  @relation(fields: [itemDfdId], references: [id])
  solicitadoPorId String
  solicitadoPor   AcessoEntrega            @relation(fields: [solicitadoPorId], references: [id])
  solicitadoEm    DateTime                 @default(now())
  status          StatusAtendimentoEstoque @default(PENDENTE_PROAD)
  motivoRejeicao  String?
  analisadoEm     DateTime?
  entregaId       String?                  @unique
  entrega         Entrega?                 @relation(fields: [entregaId], references: [id])
}

enum StatusTrocaOP {
  PENDENTE_PROAD_INICIAL
  REJEITADO_INICIAL
  PENDENTE_PATRIMONIO
  SEM_ESTOQUE
  PENDENTE_PROAD_FINAL
  REJEITADO_FINAL
  APROVADO
}

// Troca de item OP: demandante -> PROAD (triagem) -> Patrimônio
// (disponibilidade) -> PROAD (autorização final). Autorizado, cria um novo
// ItemDfd (o "item B") e uma Entrega avulsa carimbada para ele.
model TrocaOP {
  id        String        @id @default(cuid())
  itemDfdId String        @unique
  itemDfd   ItemDfd       @relation("ItemComTrocaOP", fields: [itemDfdId], references: [id])
  status    StatusTrocaOP @default(PENDENTE_PROAD_INICIAL)

  justificativaDemandante String

  // "Item B" pretendido pelo demandante — do catálogo ou personalizado (mas
  // sempre com categoria já cadastrada: mesma regra de qualquer item de
  // valor livre no restante do sistema — só o nome do item é texto livre).
  itemBOrigemCatalogo Boolean
  itemBCategoriaId    String
  itemBCategoria      Categoria @relation(fields: [itemBCategoriaId], references: [id])
  itemBNome           String
  itemBValor          Decimal   @db.Decimal(14, 2)
  itemBTipoBem        TipoBem

  analiseProadInicialOk     Boolean?
  analiseProadInicialMotivo String?
  analiseProadInicialEm     DateTime?

  analisePatrimonioDisponivel Boolean?
  analisePatrimonioPorId      String?
  analisePatrimonioPor        AcessoEntrega? @relation(fields: [analisePatrimonioPorId], references: [id])
  analisePatrimonioEm         DateTime?

  analiseProadFinalOk         Boolean?
  analiseProadFinalMotivo     String?
  analiseProadFinalExtrapolou Boolean?
  analiseProadFinalEm         DateTime?

  itemNovoId String?  @unique
  itemNovo   ItemDfd? @relation("ItemGeradoPorTrocaOP", fields: [itemNovoId], references: [id])

  solicitadoEm DateTime @default(now())

  @@index([status])
}
