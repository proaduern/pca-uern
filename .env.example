# Uso com Neon: DATABASE_URL é a connection string "pooled" (host com "-pooler")
# e DIRECT_URL é a connection string direta (sem "-pooler") — painel Neon > Connect.
DATABASE_URL="postgresql://user:password@localhost:5432/pca?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/pca?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
